{
  "name": "nearest-fitter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "oxlint",
    "format": "oxfmt",
    "setup": "node scripts/setup.mjs",
    "password": "node scripts/password.mjs",
    "db:setup": "prisma generate && node --env-file=.env scripts/prepare-db.mjs && prisma db push && node --env-file=.env scripts/seed.ts",
    "seed": "node --env-file=.env scripts/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@prisma/client": "^6.19.0",
    "@shadcn/react": "0.3.0",
    "@supabase/supabase-js": "^2.115.0",
    "@types/leaflet": "^1.9.22",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "1.31.0",
    "next": "^16.3.4",
    "prisma": "^6.19.0",
    "react": "^19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "effect": "^3.20.0"
  }
