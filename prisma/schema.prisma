generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model Fitter {
 id String @id
 name String
 type String
 phone String
 phone2 String @default("")
 whatsapp String @default("")
 photo_url String @default("")
 latitude Float
 longitude Float
 neighborhood String
 services Json
 working_hours Json
 status String @default("pending")
 demo Boolean @default(false)
 created_at String
 reviews Review[]
 dispatches DispatchRequest[]
 dashboard FitterDashboard?
 community_replies CommunityReply[]
 @@index([status])
 @@map("fitters")
}
model Review {
 id String @id
 fitter_id String
 fitter Fitter @relation(fields:[fitter_id],references:[id],onDelete:Cascade)
 reviewer_name String
 rating Int
 comment String
 status String @default("pending")
 created_at String
 @@index([fitter_id,status])
 @@map("reviews")
}
model Contact {
 id String @id
 name String
 email String
 message String
 created_at String
 @@map("contacts")
}
model RateLimit {
 key String @id
 count Int
 expires BigInt
 @@map("rate_limits")
}
model DispatchRequest {
 id              String  @id
 fitter_id       String
 fitter          Fitter  @relation(fields:[fitter_id],references:[id],onDelete:Cascade)
 user_lat        Float
 user_lng        Float
 user_phone      String
 user_note       String  @default("")
 status          String  @default("pending")
 fitter_token    String  @unique
 user_token      String  @unique
 tried_fitters   String  @default("[]")
 reassign_count  Int     @default(0)
 expires_at      String
 created_at      String
 accepted_at     String?
 completed_at    String?
 fitter_lat      Float?
 fitter_lng      Float?
 active_slot     String? @unique
 commission_percent Float @default(0)
 commission_fixed_iqd Int @default(0)
 final_price_iqd Int?
 commission_iqd  Int?
 commission_status String @default("none")
 @@index([fitter_token])
 @@index([user_token])
 @@index([status, created_at])
 @@map("dispatch_requests")
}
model FitterDashboard {
 id          String  @id
 fitter_id   String  @unique
 fitter      Fitter  @relation(fields:[fitter_id],references:[id],onDelete:Cascade)
 code        String  @unique
 created_at  String
 is_online   Boolean @default(false)
 current_lat Float?
 current_lng Float?
 last_seen_at String?
 @@index([code])
 @@map("fitter_dashboards")
}
model PlatformSetting {
 id String @id @default("platform")
 commission_percent Float @default(10)
 commission_fixed_iqd Int @default(0)
 updated_at String
 @@map("platform_settings")
}
model CommunityPost {
 id String @id
 author_name String
 title String
 car_model String
 neighborhood String
 body String
 status String @default("open")
 owner_hash String
 created_at String
 replies CommunityReply[]
 @@index([created_at], map: "community_posts_created")
 @@map("community_posts")
}
model CommunityReply {
 id String @id
 post_id String
 post CommunityPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
 fitter_id String
 fitter Fitter @relation(fields: [fitter_id], references: [id], onDelete: Cascade)
 body String
 created_at String
 @@index([post_id], map: "community_replies_post")
 @@map("community_replies")
}
